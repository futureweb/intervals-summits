# Copy to .env and fill in. Next to garmin-intervals-bridge the same key works (and its .env is read too).
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=0
# en or de: the names of the fields it creates, and the page
SUMMITS_LANGUAGE=en
# Summits,SummitCount,HighestPoint (default); add HutsPasses for huts and passes
#SUMMITS_FIELDS=Summits,SummitCount,HighestPoint
# true: also the line "⛰️ Summits: …" in the activity description, so Intervals' search finds them
#SUMMITS_DESCRIPTION=false
# only these types, e.g. Hike,BackcountrySki (default: every outdoor type)
#SUMMITS_TYPES=
