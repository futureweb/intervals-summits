# Copy to .env and fill in. Next to garmin-intervals-bridge the same key works (and its .env is read too).
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=0
# en or de: the names of the fields it creates, and the page
SUMMITS_LANGUAGE=en
# Summits,SummitCount,HighestPoint (default); add Huts,Passes for huts and passes
#SUMMITS_FIELDS=Summits,SummitCount,HighestPoint
# true: also the line "⛰️ Summits: …" in the activity description, so Intervals' search finds them
#SUMMITS_DESCRIPTION=false
# only these types, e.g. Hike,BackcountrySki (default: every outdoor type)
#SUMMITS_TYPES=
# collections on the summit log page: Label=Area>=height; … (area: its OpenStreetMap name, or r<relation id>)
#SUMMITS_COLLECTIONS=Tirol 3000ers=r52343>=3000
# the page somewhere else (a web server's folder), in a language of its own
#SUMMITS_PAGE_FILE=/var/www/example/summits/index.html
#SUMMITS_PAGE_LANGUAGE=de
